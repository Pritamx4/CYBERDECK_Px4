// Toast Notification Function
function showToast(message, type = 'success') {
  const toast = document.getElementById('toast');
  const toastMessage = toast.querySelector('.toast-message');
  
  toastMessage.textContent = message;
  toast.className = `toast ${type}`;
  toast.classList.add('show');
  
  setTimeout(() => {
    toast.classList.remove('show');
  }, 4000);
}

// ========================================
// 1. NAVBAR FUNCTIONALITY
// ========================================

// Toggle mobile menu with GSAP animations
function toggleMenu() {
  const navLinks = document.getElementById('navLinks');
  const menuIcon = document.querySelector('.menu-icon');
  const menuItems = document.querySelectorAll('.nav-item');

  // Check if GSAP is loaded
  if (typeof gsap === 'undefined') {
    console.error('GSAP not loaded');
    navLinks.classList.toggle('show');
    return;
  }

  if (!navLinks.classList.contains('show')) {
    // Opening animation - each item starts when previous is 20% done
    navLinks.classList.add('show');
    menuIcon.classList.add('active');

    // Fade in background first
    gsap.to(navLinks, {
      opacity: 1,
      duration: 0.3,
      ease: 'power2.out'
    });

    // Animate each item with cascade effect
    menuItems.forEach((item, index) => {
      gsap.fromTo(item, 
        {
          opacity: 0,
          x: '100%'
        },
        {
          opacity: 1,
          x: 0,
          duration: 0.6,
          delay: index * 0.12, // Each starts when previous is 20% done (0.6 * 0.2 = 0.12)
          ease: 'power3.out'
        }
      );
    });

  } else {
    // Closing animation - reverse cascade
    menuIcon.classList.remove('active');

    // Animate items out
    menuItems.forEach((item, index) => {
      gsap.to(item, {
        opacity: 0,
        x: '100%',
        duration: 0.4,
        delay: index * 0.05,
        ease: 'power2.in'
      });
    });

    // Fade out background
    gsap.to(navLinks, {
      opacity: 0,
      duration: 0.3,
      delay: 0.3,
      ease: 'power2.in',
      onComplete: () => {
        navLinks.classList.remove('show');
      }
    });
  }
}

// Auto-close menu when a link is clicked (on mobile)
document.addEventListener('DOMContentLoaded', () => {
  const links = document.querySelectorAll('#navLinks a');

  links.forEach(link => {
    link.addEventListener('click', () => {
      const navLinks = document.getElementById('navLinks');
      
      if (navLinks.classList.contains('show')) {
        toggleMenu();
      }
    });
  });
});

